# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Direct connection — use this for local dev AND Hostinger Node.js hosting
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Direct URL used by Prisma CLI (db push, migrate, studio)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# NOTE: For Vercel/serverless deployments only, swap DATABASE_URL to the pooler:
# DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters — generate with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-very-long-random-secret-key-minimum-32-chars"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Khairpur Tamewali"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NODE_ENV="production"

# ── Image Uploads ─────────────────────────────────────────────────────────────
# Folder inside /public for uploaded images
UPLOAD_DIR="public/uploads"
