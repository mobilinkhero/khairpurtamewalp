# ── Database (MySQL) ──────────────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=3"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters — generate with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-very-long-random-secret-key-minimum-32-chars"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Khairpur Tamewali"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Image Uploads ─────────────────────────────────────────────────────────────
# Folder inside /public for uploaded images
UPLOAD_DIR="public/uploads"
