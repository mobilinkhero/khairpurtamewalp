generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Admin Users ───────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

// ── Businesses ────────────────────────────────────────────────────────────────
model Business {
  id           String   @id @default(uuid())
  name         String
  category     String
  description  String   @db.Text
  address      String
  phone        String
  imageUrl     String
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  isOpen       Boolean  @default(true)
  workingHours String
  isFeatured   Boolean  @default(false)
  tags         String   @db.Text  // JSON array stored as string
  lat          Float
  lng          Float
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("businesses")
}

// ── Places ────────────────────────────────────────────────────────────────────
model Place {
  id          String   @id @default(uuid())
  name        String
  category    String
  description String   @db.Text
  address     String
  imageUrl    String
  facilities  String   @db.Text  // JSON array
  isFeatured  Boolean  @default(false)
  phone       String
  lat         Float
  lng         Float
  distance    String   @default("--")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("places")
}

// ── News ──────────────────────────────────────────────────────────────────────
model News {
  id          String   @id @default(uuid())
  title       String
  summary     String   @db.Text
  content     String   @db.LongText
  imageUrl    String
  category    String
  author      String
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news")
}

// ── Events ────────────────────────────────────────────────────────────────────
model Event {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  imageUrl    String
  date        DateTime
  time        String
  venue       String
  organizer   String
  isFree      Boolean  @default(true)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

// ── App Settings (key-value store) ───────────────────────────────────────────
model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.LongText
  label     String
  type      String   @default("text")   // text | image | boolean | number
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ── Categories ────────────────────────────────────────────────────────────────
model Category {
  id        String   @id @default(uuid())
  name      String
  type      String   // business | place | news | event
  color     String   @default("#1B5E20")
  icon      String   @default("📁")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, type])
  @@map("categories")
}

// ── Media / Gallery ───────────────────────────────────────────────────────────
model MediaFile {
  id          String   @id @default(uuid())
  filename    String
  url         String   @db.Text
  mimeType    String   @default("image/jpeg")
  size        Int      @default(0)
  alt         String   @default("")
  uploadedBy  String   @default("admin")
  createdAt   DateTime @default(now())

  @@map("media_files")
}

// ── Banners ───────────────────────────────────────────────────────────────────
model Banner {
  id          String   @id @default(uuid())
  title       String
  subtitle    String   @default("")
  imageUrl    String   @db.Text
  linkUrl     String   @default("")
  linkLabel   String   @default("")
  type        String   @default("info")   // info | warning | emergency | promo
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("banners")
}

// ── Testimonials / Reviews ────────────────────────────────────────────────────
model Testimonial {
  id          String   @id @default(uuid())
  name        String
  role        String   @default("")
  content     String   @db.Text
  rating      Int      @default(5)
  avatarUrl   String   @default("")
  isApproved  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("testimonials")
}

// ── FAQs ──────────────────────────────────────────────────────────────────────
model FAQ {
  id          String   @id @default(uuid())
  question    String   @db.Text
  answer      String   @db.LongText
  category    String   @default("General")
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faqs")
}

// ── Activity Log ──────────────────────────────────────────────────────────────
model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  userName    String
  action      String   // created | updated | deleted | published | unpublished | login | logout
  entity      String   // business | place | news | event | banner | faq | user | settings
  entityId    String   @default("")
  entityName  String   @default("")
  detail      String   @db.Text
  ipAddress   String   @default("")
  createdAt   DateTime @default(now())

  @@map("activity_logs")
}

// ── Business Claim Requests ───────────────────────────────────────────────────
model ClaimRequest {
  id          String   @id @default(uuid())
  businessId  String
  businessName String
  claimerName String
  claimerPhone String
  otp         String
  otpExpiresAt DateTime
  status      String   @default("pending") // pending | verified | approved | rejected
  note        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("claim_requests")
}

// ── Emergency Contacts ────────────────────────────────────────────────────────
model EmergencyContact {
  id        String   @id @default(uuid())
  name      String
  number    String
  icon      String
  color     String   @default("#D32F2F")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("emergency_contacts")
}
